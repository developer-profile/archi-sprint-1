        <mxCell id="hddz2nBb14Sx0p2ruGVg-123" value="Поиск товаров" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontColor=#FFFFFF;strokeColor=none;" parent="hddz2nBb14Sx0p2ruGVg-120" vertex="1">
